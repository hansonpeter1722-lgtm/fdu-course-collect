---
import '../styles/global.css';
import stats from '../data/stats.json';
import { href } from '../lib/links';
interface Props { title?: string; description?: string }
const { title, description = '为复旦同学整理的课程、试题与代码资料入口。按课程查找，直接打开原始链接。' } = Astro.props;
const navigation = [['', '首页'], ['courses/', '课程'], ['schedule/', '2026 开课'], ['exams/', '试题'], ['collections/', '合集'], ['about/', '关于']];
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').split('/')[0];
const buildTime = new Date(stats.builtAt).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour12: false });
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f0" />
    <title>{title ? `${title} · 复旦课程资料索引` : '复旦课程资料索引'}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header"><div class="shell header-inner"><a class="brand" href={href()} aria-label="复旦课程资料索引首页"><span class="brand-mark" aria-hidden="true">≋</span><span>复旦课程资料索引<small>同学整理 · 非官方网站</small></span></a><nav aria-label="主导航">{navigation.map(([path, label]) => <a href={href(path)} aria-current={current === path.split('/')[0] ? 'page' : undefined}>{label}</a>)}</nav><a class="nav-search" href={href('search/')} aria-label="全局搜索"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>搜索</span></a></div></header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer"><div class="shell footer-inner"><div><strong>复旦课程资料索引</strong><p>只收链接，不存内容。资料权利归原作者所有。</p></div><div class="footer-links"><a href={href('about/#license')}>数据许可</a><a href={href('about/#disclaimer')}>免责声明</a><a href={href('about/#removal')}>移除请求</a><small>构建于 {buildTime}（北京时间）</small></div></div></footer>
  </body>
</html>
